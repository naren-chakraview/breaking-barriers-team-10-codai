# Copy to .env.local (gitignored) and fill in. NAMES ONLY here — never commit real values.
# Secrets and account-specific values stay out of the repo (C-38, ADR-013, architecture 2.14).

# --- AWS session (set in your shell or via `aws login` / SSO; do NOT put real keys here) ---
AWS_DEFAULT_REGION=us-west-2
# Account id is shared out-of-band (team chat), not committed.

# --- Mode switches (architecture 1.8) ---
# VITE_ values are public and end up in the browser bundle. The others are backend-only.
VITE_SERVICE_MODE=mock        # mock | http
MODEL_MODE=stub               # stub | bedrock
STORE_MODE=json               # json | aurora

# --- Front end ---
VITE_API_BASE_URL=            # e.g. https://<api-id>.execute-api.us-west-2.amazonaws.com/prod

# --- Backend config: NAMES of SSM parameters, resolved at runtime (not the values) ---
SSM_PREFIX=/codeai

# --- Aurora (read from CDK stack outputs after deploy; never hard-code) ---
# The backend uses the Data API, so there is no DB username/password here.
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE_NAME=codeai

# --- Demo identity for the HTTP services client (VITE_SERVICE_MODE=http) ---
# Public demo values only (there is no real login in demo mode, C-33). The client
# sends these as the P-1.4 headers: Authorization: Bearer <token>, X-User-Id, X-Role.
VITE_DEMO_TOKEN=demo-token
VITE_DEMO_USER_ID=stu-quick
VITE_DEMO_ROLE=student        # student | teacher

# --- Authentication (ADR-018) ---
# mock (default): the no-AWS demo login (uses the VITE_DEMO_* identity above, C-33).
# cognito: the real authorization-code + PKCE flow against a Cognito user pool. When set to
# cognito, the live access token / role (from the user's Cognito group) replace the
# VITE_DEMO_* identity, so those demo values are not used.
VITE_AUTH_MODE=mock           # mock | cognito

# Public Cognito user-pool OIDC settings (no client secret — a browser is a public client).
# Filled from the user-pool stack outputs once Track A provisions the pool.
VITE_COGNITO_AUTHORITY=       # e.g. https://cognito-idp.us-west-2.amazonaws.com/<userPoolId>
VITE_COGNITO_CLIENT_ID=       # the public app-client id
VITE_COGNITO_REDIRECT_URI=    # this app's callback URL, e.g. https://<app-host>/
VITE_COGNITO_LOGOUT_URI=      # optional; defaults to the redirect URI
VITE_COGNITO_SCOPE=openid profile email
