{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeai.local/contracts/tree.schema.json",
  "title": "Skill tree (content contract)",
  "description": "The parts of database/sample-skilltree.json that the platform depends on (C-4, C-5, C-6). Extra content fields are allowed. Content integrity rules that a schema cannot express live in tests/tree-content.test.js.",
  "$defs": {
    "Skill": {
      "type": "object",
      "required": ["id", "title", "evidenceLevels"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "evidenceLevels": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "pattern": "^[0-3]$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Question": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "integer" },
        "type": { "enum": ["freeResponse", "MultipleChoiceQuestion"] },
        "measures": {
          "type": "object",
          "required": ["skillId", "evidenceLevels"],
          "properties": {
            "skillId": { "$ref": "common.schema.json#/$defs/Slug" },
            "evidenceLevels": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z]$" },
              "additionalProperties": { "$ref": "common.schema.json#/$defs/Level" }
            }
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "required": ["id", "title", "kind"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["panels", "questions", "level", "review"] },
        "project": { "type": "boolean" },
        "instructionsPrompt": { "type": "string" },
        "validation": {
          "type": "object",
          "required": ["condition", "measures"],
          "properties": {
            "condition": { "type": "string", "minLength": 1 },
            "measures": {
              "type": "object",
              "required": ["skillId"],
              "properties": { "skillId": { "$ref": "common.schema.json#/$defs/Slug" } }
            }
          }
        },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/Question" } }
      }
    },
    "Checkpoint": {
      "type": "object",
      "required": ["id", "title", "steps"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "skillIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Slug" } },
        "requires": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Slug" } },
        "targetEvidenceLevels": {
          "type": "object",
          "additionalProperties": { "$ref": "common.schema.json#/$defs/Level" }
        },
        "skippable": { "type": "boolean" },
        "routeAfterCompletion": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Step" } }
      }
    },
    "Tree": {
      "type": "object",
      "required": ["formatVersion", "id", "title", "skills", "checkpoints"],
      "properties": {
        "formatVersion": { "type": "integer" },
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "title": { "type": "string", "minLength": 1 },
        "skills": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/Skill" } },
        "checkpoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Checkpoint" } }
      }
    }
  },
  "$ref": "#/$defs/Tree"
}
