erDiagram
    COURSE ||--o{ SKILLS : "has"
    SKILLS ||--o{ MCQ_QUESTIONS : "assessed by"
    SKILLS ||--o{ LEARNING_EXAMPLES : "illustrated by"
    SKILLS ||--o{ STUDENT : "tracked per"
    SKILLS ||--o{ SKILL_TIER_CONTENT : "delivered as"
    SKILLS ||--o{ SKILL_RUBRIC_CRITERIA : "scored by"
    SKILLS ||--o{ SKILL_LEVEL_DESCRIPTOR : "described per level by"
    COMPETENCE_LEVELS_MASTER ||--o{ STUDENT : "level of"
    COMPETENCE_LEVELS_MASTER ||--o{ SKILL_LEVEL_DESCRIPTOR : "describes"
    STUDENT_PROFILE ||--o{ STUDENT : "progress of"
    STUDENT_PROFILE ||--o{ STUDENT_ENROLLED_COURSES : "enrolls in"
    COURSE ||--o{ STUDENT_ENROLLED_COURSES : "enrolled by"

    %% Course structure: checkpoints and steps. Ids are the string slugs from
    %% sample-skilltree.json (C-5), not integers.
    COURSE ||--o{ CHECKPOINT : "contains"
    CHECKPOINT ||--o{ CHECKPOINT_REQUIRES : "has prerequisite"
    CHECKPOINT ||--o{ CHECKPOINT_REQUIRES : "is prerequisite of"
    CHECKPOINT ||--o{ CHECKPOINT_TARGET : "targets skill at"
    SKILLS ||--o{ CHECKPOINT_TARGET : "targeted by"
    CHECKPOINT ||--o{ STEP : "made up of"
    SKILLS ||--o{ STEP : "validated against"
    STEP ||--o{ MEASURE : "scores"
    SKILLS ||--o{ MEASURE : "measured by"
    STEP ||--o{ STEP_ATTEMPT : "attempted as"
    CHECKPOINT ||--o{ CHECKPOINT_PROGRESS : "tracked as"
    CHECKPOINT ||--o{ ROUTING_DECISION : "proposed or applied in"
    STEP ||--o{ HINT_EVENT : "hinted on"
    STEP ||--o{ FALLBACK_EVENT : "failed on"
    STEP ||--o{ STUDENT_SKILL_EVIDENCE : "source of"

    %% Transactional state (architecture 2.9). Master data above, student state below.
    STUDENT_PROFILE ||--o{ STUDENT_SKILL_EVIDENCE : "has"
    SKILLS ||--o{ STUDENT_SKILL_EVIDENCE : "measured as"
    STUDENT_PROFILE ||--o{ STEP_ATTEMPT : "makes"
    STUDENT_PROFILE ||--o{ CHECKPOINT_PROGRESS : "has"
    STUDENT_PROFILE ||--o{ REMEDIATION_FLAG : "may have"
    SKILLS ||--o{ REMEDIATION_FLAG : "raised on"
    STUDENT_PROFILE ||--o{ ROUTING_DECISION : "is routed by"
    STUDENT_PROFILE ||--o{ FALLBACK_EVENT : "may trigger"
    STUDENT_PROFILE ||--o{ PASSIVE_SIGNAL : "is assessed by"
    STUDENT_PROFILE ||--o{ HINT_EVENT : "receives"
    TEACHER ||--|| TEACHER_CONFIG : "sets"
    TEACHER ||--o{ ROUTING_DECISION : "may override"

    COURSE {
        int CourseId PK
        varchar CourseTitle
    }
    SKILLS {
        int SkillId PK
        int CourseId FK
        varchar Title
        text Description
        text LessonObjective
    }
    COMPETENCE_LEVELS_MASTER {
        int LevelId PK
        varchar LevelName
        text Rubric
        int ThresholdInMCQ
    }
    MCQ_QUESTIONS {
        int QuestionId PK
        int SkillId FK
        text MCQQuestion
        text PossibleAnswers
        varchar CorrectAnswer
    }
    LEARNING_EXAMPLES {
        int ExampleId PK
        int SkillId FK
        blob Example
    }
    SKILL_TIER_CONTENT {
        int TierContentId PK
        int SkillId FK
        varchar Tier "core, support or depth"
        varchar Title
        text Instructions
        text StarterCode
        text Hints
    }
    SKILL_RUBRIC_CRITERIA {
        int CriterionId PK
        int SkillId FK
        varchar Description
        decimal Weight "0 to 1, sums to 1 per skill"
        varchar Method "dom or llm"
        text CheckSpec "JSON"
    }
    CHECKPOINT {
        varchar CheckpointId PK "slug"
        int CourseId FK
        varchar Title
        text Description
        varchar Destination
        boolean Skippable "can be tested out"
        boolean RouteAfterCompletion
        int Sequence "JSON order, used for the linear fallback path"
    }
    CHECKPOINT_REQUIRES {
        varchar CheckpointId FK
        varchar RequiresCheckpointId FK
    }
    CHECKPOINT_TARGET {
        varchar CheckpointId FK
        int SkillId FK
        int TargetEvidenceLevel "default 1"
    }
    STEP {
        varchar StepId PK "slug"
        varchar CheckpointId FK
        int Sequence
        varchar Kind "panels, multiple choice, project and so on"
        varchar Title
        boolean IsProject "project step is validated by the LLM judge"
        text Instructions
        text InstructionsPrompt
        text Payload "JSON"
        text ValidationCondition
        int ValidationSkillId FK
    }
    MEASURE {
        int MeasureId PK
        varchar StepId FK
        int SkillId FK
        varchar QuestionName
        text EvidenceMap "JSON, maps a choice to an evidence level, no model call"
    }
    SKILL_LEVEL_DESCRIPTOR {
        int SkillId FK
        int LevelId FK
        text Descriptor
    }
    STUDENT_PROFILE {
        int StudentId PK
        varchar Name
    }
    STUDENT {
        int StudentId FK
        int SkillId FK
        int CompetenceLevel FK
        int McqScore
        datetime CreatedAt
        datetime UpdatedAt
    }
    STUDENT_ENROLLED_COURSES {
        int StudentId FK
        int CourseId FK
    }

    TEACHER {
        int TeacherId PK
        varchar Name
    }
    TEACHER_CONFIG {
        int TeacherId PK, FK
        int AnswerTimeoutSeconds "default 180"
    }
    STUDENT_SKILL_EVIDENCE {
        int EvidenceId PK
        int StudentId FK
        int SkillId FK
        int Level "append-only, skill level is the max observed"
        varchar SourceStepId FK "step slug"
        datetime CreatedAt
    }
    STEP_ATTEMPT {
        varchar AttemptId PK
        int StudentId FK
        varchar StepId FK "step slug"
        text InputText "restricted and encrypted"
        varchar ProjectSnapshotRef
        int EvidenceLevel
        float Confidence "0 to 1"
        varchar PromptVersion "prompt hash"
        datetime CreatedAt
    }
    CHECKPOINT_PROGRESS {
        int StudentId FK
        varchar CheckpointId FK "checkpoint slug"
        varchar Status "locked, available, current, completed or tested_out"
        datetime UpdatedAt
    }
    REMEDIATION_FLAG {
        int FlagId PK
        int StudentId FK
        int SkillId FK
        varchar Reason
        varchar Severity "normal or high"
        datetime CreatedAt
        datetime ResolvedAt
    }
    ROUTING_DECISION {
        varchar DecisionId PK
        int StudentId FK
        int TeacherId FK "set when a teacher held or assigned"
        varchar ProposedCheckpointId FK
        varchar TeacherInput "auto, hold or assign"
        varchar AppliedCheckpointId FK
        text Reason
        datetime CreatedAt
    }
    FALLBACK_EVENT {
        int FallbackEventId PK
        int StudentId FK
        varchar StepId FK "step slug"
        varchar Component "validation, routing, generation, safety or passive"
        text Error
        datetime CreatedAt
    }
    PASSIVE_SIGNAL {
        varchar SignalId PK
        int StudentId FK
        varchar Signal "speed_up, slow_down, redirect, reengage or steady"
        varchar HintStyle "guiding_question, example, analogy or step_by_step"
        varchar AngleToTry
        text Reason
        text EvidenceRefs "JSON array"
        float Confidence "0 to 1"
        varchar FeaturesHash "cache lookup key"
        varchar ModelId "null when rule-based"
        varchar PromptVersion
        datetime CreatedAt
    }
    HINT_EVENT {
        int HintEventId PK
        int StudentId FK
        varchar StepId FK "step slug"
        varchar HintStyle
        varchar Angle "explanation angle used"
        datetime CreatedAt
    }

    %% ---- Student-state tables (C-8). Physical store: Aurora PostgreSQL (ADR-016),
    %% or a JSON file in demo mode. snake_case columns; see infra/schema.sql. ----
    STUDENT ||--o{ STUDENT_SKILL_EVIDENCE : has
    STUDENT ||--o{ STEP_ATTEMPT : makes
    STUDENT ||--o{ CHECKPOINT_PROGRESS : has
    STUDENT ||--o{ REMEDIATION_FLAG : "may have"
    STUDENT ||--o{ ROUTING_DECISION : "routed by"
    STUDENT ||--o{ FALLBACK_EVENT : "may trigger"
    STUDENT ||--o{ PASSIVE_SIGNAL : "assessed by"
    STUDENT ||--o{ HINT_EVENT : "shown"
    STUDENT ||--|| TEACHER_INPUT : "has"
    SKILL ||--o{ STUDENT_SKILL_EVIDENCE : "measured as"
    STEP ||--o{ STEP_ATTEMPT : "attempted as"
    CHECKPOINT ||--o{ CHECKPOINT_PROGRESS : "tracked as"

    STUDENT {
        varchar student_id PK
        varchar display_name
        boolean synthetic
    }
    STUDENT_SKILL_EVIDENCE {
        bigint id PK
        varchar student_id FK
        varchar skill_id FK
        int level
        varchar source_step_id
        timestamptz created_at
    }
    STEP_ATTEMPT {
        varchar attempt_id PK
        varchar student_id FK
        varchar step_id FK
        text input_text
        varchar project_snapshot_ref
        int evidence_level
        float confidence
        timestamptz created_at
    }
    CHECKPOINT_PROGRESS {
        varchar student_id FK
        varchar checkpoint_id FK
        varchar status
        timestamptz updated_at
    }
    REMEDIATION_FLAG {
        bigint id PK
        varchar student_id FK
        varchar skill_id FK
        text reason
        varchar severity
        timestamptz created_at
        timestamptz resolved_at
    }
    ROUTING_DECISION {
        varchar decision_id PK
        varchar student_id FK
        varchar proposed_checkpoint_id
        json teacher_input
        varchar applied_checkpoint_id
        text reason
        timestamptz created_at
    }
    FALLBACK_EVENT {
        bigint id PK
        varchar student_id FK
        varchar step_id
        varchar component
        text error
        timestamptz created_at
    }
    PASSIVE_SIGNAL {
        varchar signal_id PK
        varchar student_id FK
        varchar signal
        varchar hint_style
        varchar angle_to_try
        text reason
        json evidence_refs
        float confidence
        varchar features_hash
        varchar model_id
        varchar prompt_version
        timestamptz created_at
    }
    HINT_EVENT {
        varchar hint_id PK
        varchar student_id FK
        varchar step_id
        varchar style
        varchar angle
        timestamptz created_at
    }
    TEACHER_INPUT {
        varchar student_id PK
        varchar mode
        varchar checkpoint_id
        timestamptz updated_at
    }
    TEACHER_CONFIG {
        varchar teacher_id PK
        int answer_timeout_seconds
    }
